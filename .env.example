# Copy this file to .env and fill in the values you need.
# Never commit .env to git.

# --- LLM backends ---
# Choose ONE primary backend. The others can be left blank.

# Ollama (local — recommended for development)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic (cloud — recommended for validation runs)
# ANTHROPIC_API_KEY=

# OpenAI (cloud — alternative)
# OPENAI_API_KEY=

# Google AI Studio / Gemini (cloud — free tier available)
# GOOGLE_API_KEY=

# --- Token budget enforcement ---
TOKEN_BUDGET_PER_TASK=100000

# --- Experiment configuration ---
RESULTS_DIR=./results/runs
RAG_INDEX_DIR=./rag_index
LOG_LEVEL=INFO

# --- Docker configuration ---
DOCKER_HOST=unix:///var/run/docker.sock
TEST_NETWORK_NAME=dissertation_test_net
