{
  "nginx": {
    "http": {
      "gzip": true,
      "keepalive_requests": 100,
      "keepalive_timeout": 65,
      "sendfile": true,
      "tcp_nodelay": true,
      "tcp_nopush": true
    },
    "security": {
      "autoindex": false,
      "client_max_body_size": "10m",
      "server_tokens": false
    },
    "ssl": {
      "ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
      "prefer_server_ciphers": true,
      "protocols": [
        "TLSv1.2",
        "TLSv1.3"
      ],
      "session_cache": "shared:SSL:10m",
      "session_timeout": "1d",
      "stapling": true
    },
    "worker": {
      "worker_connections": 1024,
      "worker_processes": "auto"
    }
  },
  "pg_hba": {
    "rules": [
      {
        "address": null,
        "auth_method": "peer",
        "database": "all",
        "type": "local",
        "user": "all"
      },
      {
        "address": "127.0.0.1/32",
        "auth_method": "scram-sha-256",
        "database": "all",
        "type": "host",
        "user": "all"
      },
      {
        "address": "0.0.0.0/0",
        "auth_method": "scram-sha-256",
        "database": "all",
        "type": "hostssl",
        "user": "all"
      }
    ]
  },
  "postgres": {
    "connections": {
      "max_connections": 200,
      "superuser_reserved_connections": 3
    },
    "listen_addresses": "*",
    "logging": {
      "log_destination": "stderr",
      "log_min_duration_statement": 1000,
      "log_statement": "ddl"
    },
    "memory": {
      "effective_cache_size": "6GB",
      "maintenance_work_mem": "512MB",
      "shared_buffers": "2GB",
      "work_mem": "32MB"
    },
    "security": {
      "log_connections": true,
      "log_disconnections": true,
      "password_encryption": "scram-sha-256",
      "ssl": true,
      "ssl_min_protocol_version": "TLSv1.2"
    },
    "wal": {
      "checkpoint_completion_target": 0.9,
      "max_wal_size": "1GB",
      "wal_level": "replica"
    }
  },
  "rabbitmq": {
    "management": {
      "enabled": true,
      "listener_ip": "127.0.0.1",
      "port": 15672
    },
    "networking": {
      "heartbeat": 60,
      "listener_ip": "0.0.0.0",
      "listener_port": 5672,
      "max_connections": 500
    },
    "resources": {
      "disk_free_limit": "2GB",
      "vm_memory_high_watermark": 0.4,
      "vm_memory_high_watermark_paging_ratio": 0.5
    },
    "security": {
      "default_pass": "change-me-strong-password",
      "default_user": "appuser",
      "loopback_users": [
        "guest"
      ],
      "tls_enabled": false,
      "tls_port": 5671,
      "tls_verify_peer": false
    }
  },
  "redis": {
    "memory": {
      "maxmemory": "512MB",
      "maxmemory_policy": "allkeys-lru",
      "maxmemory_samples": 5
    },
    "networking": {
      "bind": [
        "127.0.0.1"
      ],
      "port": 6379,
      "tls_port": null
    },
    "persistence": {
      "appendfsync": "everysec",
      "appendonly": true,
      "save": [
        "3600 1",
        "300 100"
      ]
    },
    "security": {
      "protected_mode": true,
      "rename_commands": {
        "CONFIG": "CONFIG_a1b2c3",
        "FLUSHALL": ""
      },
      "requirepass": "change-me-strong-password"
    }
  },
  "requirements": {
    "backup_required": false,
    "compliance": "NONE",
    "expected_concurrent_users": 50,
    "expected_data_size_gb": 10.0,
    "hardware": {
      "disk_gb": 100.0,
      "ram_gb": 8.0,
      "vcpu": 4
    },
    "selected_services": null,
    "workload_class": "BALANCED"
  }
}